# Copiá este archivo a ".env" y completá los valores.
# En desarrollo local podés dejarlo todo como está: la app anda sin configurar nada.

# Base de datos. Si no se define, se usa un archivo SQLite local (presupuestos.db).
# En producción (Render, Railway, etc.) va la cadena de conexión de Postgres, algo así:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/nombre_db
DATABASE_URL=

# Primer usuario (dueño). Se crea al arrancar SOLO si todavía no hay ningún usuario; después
# estas variables ya no se usan y conviene borrarlas: la contraseña se cambia desde la app.
# Usuario: 3 a 40 caracteres (letras sin tildes, números, punto, guion, guion bajo).
# Contraseña: 10 a 128 caracteres. Para crear más usuarios: pantalla "Usuarios" de la app,
# o `uv run python -m presupuestos_backend.usuarios_cli --help` en la terminal.
# Tras 5 intentos de login fallidos desde una misma IP se bloquea el acceso por 15 minutos.
DUENO_USUARIO=
DUENO_PASSWORD=
DUENO_NOMBRE=

# Clave secreta usada para firmar la sesión. En producción es OBLIGATORIA, propia
# y de al menos 32 caracteres (por ejemplo, generada con: openssl rand -hex 32).
SECRET_KEY=clave-de-desarrollo-cambiar-en-produccion

# "production" en el servidor final, "development" en tu computadora.
ENV=development

# Dirección desde la que se sirve el frontend en desarrollo (Vite).
FRONTEND_ORIGIN=http://localhost:5173

# Datos del negocio que salen impresos en el PDF del presupuesto. Nunca van en el código.
# Los que queden vacíos simplemente no se imprimen. Ejemplo de cómo completarlos en tu .env:
# NEGOCIO_RESPONSABLE=Nombre de quien atiende
# NEGOCIO_TELEFONO=11 0000 0000
# NEGOCIO_INSTAGRAM=@usuario
NEGOCIO_NOMBRE=Obras Demo
NEGOCIO_RUBRO=Pintura y reparaciones generales
NEGOCIO_RESPONSABLE=
NEGOCIO_TELEFONO=
NEGOCIO_INSTAGRAM=

# Asistente IA (Gemini) para completar presupuestos a partir del pedido del cliente.
# La clave se saca de https://aistudio.google.com/apikey . Si se deja vacía, el
# asistente no aparece en la app y todo lo demás funciona igual.
# Ojo: en el plan gratuito Google puede usar los textos enviados para entrenar sus
# modelos; como los pedidos traen datos de clientes, conviene usar una clave paga.
GEMINI_API_KEY=
# Opcional: modelos a usar, en orden de preferencia y separados por coma. Antes de
# cada pedido se consulta cuáles tiene habilitados la clave; si uno falla se pasa al
# siguiente. Por defecto: gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
GEMINI_MODELS=

# Chat del ayudante por webhook de Copilot Studio (opcional; si está, reemplaza a Gemini en el chat).
# La URL es un secreto: nunca en el repo ni en el chat.
AGENTE_WEBHOOK_URL=
