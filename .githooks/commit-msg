#!/bin/sh
# Valida que el mensaje del commit siga Conventional Commits: "tipo(ámbito opcional): descripción".
# Se activa una vez por clon con:  git config core.hooksPath .githooks
# No valida los merges, los revert automáticos ni los fixup!/squash! (los arma git solo).

archivo="$1"
# Primera línea que no sea un comentario (git agrega líneas que empiezan con # en el editor).
asunto=$(grep -v '^#' "$archivo" | sed -n '/./{p;q;}')

case "$asunto" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

TIPOS='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

if ! printf '%s' "$asunto" | grep -Eq "^($TIPOS)(\([a-z0-9._/-]+\))?!?: .+"; then
  cat >&2 <<MENSAJE
✗ El mensaje del commit no sigue Conventional Commits.

  Formato:   tipo(ámbito opcional): descripción corta en minúscula
  Tipos:     feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  Ejemplos:  feat: calendario de trabajos
             fix(cobros): no permitir una fecha futura
             refactor!: cambiar el contrato de agendar   (el ! marca un cambio que rompe)

  Tu mensaje: "$asunto"
MENSAJE
  exit 1
fi

if [ "$(printf '%s' "$asunto" | wc -m)" -gt 100 ]; then
  echo "✗ La primera línea tiene más de 100 caracteres: resumí el asunto y dejá el detalle en el cuerpo." >&2
  exit 1
fi
